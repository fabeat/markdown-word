# Dependencies, installed by Composer.
/vendor/

# Not committed: this is a library, and a lock file would only pin the versions
# for whoever happens to clone it. Continuous integration resolves them afresh, so
# a new release of a dependency is tested the day it appears.
/composer.lock
/composer.runtime.json
/composer.runtime.lock

# Everything the build produces.

# The phar, and the directory it is assembled in.
/build/

# The documents and previews examples/build.php writes.
/examples/out/

# Scratch space for the tests and the checking scripts.
/tmp/

# Test runner state.
/.phpunit.cache/
/.phpunit.result.cache

# A local override; the committed configuration is phpunit.xml.dist.
/phpunit.xml

# Coverage reports, if written next to the project rather than into build/.
/coverage/
/coverage.xml
/clover.xml

# Editors and operating systems.
.DS_Store
.idea/
.vscode/
*.swp
*~
