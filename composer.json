{
    "name": "fabeat/markdown-word",
    "description": "Pure PHP Markdown to Word (DOCX) generator and back, built on PHPWord. Full CommonMark and GitHub-Flavored Markdown support, configurable styling, Word template rendering, and a command line utility.",
    "type": "library",
    "keywords": [
        "markdown",
        "docx",
        "word",
        "phpword",
        "commonmark",
        "gfm",
        "converter",
        "template",
        "cli",
        "phar",
        "pandoc"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Graßl",
            "email": "mail@fabiangrassl.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "phpoffice/phpword": "^1.4",
        "league/commonmark": "^2.10"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "MarkdownWord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkdownWord\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=unit",
        "test:spec": "pest --testsuite=conformance",
        "test:roundtrip": "pest --testsuite=roundtrip",
        "test:readme": "pest --testsuite=readme",
        "test:coverage": "pest --coverage --min=91 --coverage-clover=build/coverage/clover.xml --coverage-html=build/coverage/html",
        "cli": "@php bin/mdword --version",
        "check": [
            "@composer validate --strict",
            "@check:audit",
            "@check:cli",
            "@php smoke.php",
            "@php stress.php",
            "@php vendor/bin/pest"
        ],
        "check:audit": "@composer audit --no-interaction",
        "check:cli": "@cli",
        "check:coverage": "@test:coverage",
        "build:phar": "@php -d phar.readonly=0 tools/build-phar.php"
    },
    "bin": [
        "bin/mdword"
    ],
    "suggest": {
        "symfony/yaml": "Lets CommonMarkParser::withAllExtensions() read YAML front matter. The `yaml` PHP extension does the same."
    }
}
